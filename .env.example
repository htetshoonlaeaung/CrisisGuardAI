# Server configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Local Node dev server persistence. Defaults to ./crisisguard.local-db.json when unset.
CRISISGUARD_DB_FILE=./crisisguard.local-db.json

# FastAPI/PostgreSQL backend, when running backend/ directly.
DATABASE_URL=sqlite+aiosqlite:///./crisisguard.db

# Password reset email delivery through Resend.
# Leave blank in local development to keep reset delivery disabled.
RESEND_API_KEY=
EMAIL_FROM=CrisisGuard AI <no-reply@example.com>
